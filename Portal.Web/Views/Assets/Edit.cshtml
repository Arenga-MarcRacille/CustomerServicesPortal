@model Portal.Data.Assets

@{
    ViewData["Title"] = "Edit Asset";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Edit Asset</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="AssetId" />

                        <div class="mb-3">
                            <label asp-for="AssetName" class="form-label fw-bold">Asset Name / Unit Model</label>
                            <input asp-for="AssetName" class="form-control" placeholder="e.g. Dell Latitude 5420" />
                            <span asp-validation-for="AssetName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AssetType" class="form-label fw-bold">Asset Type</label>
                            <select asp-for="AssetType" class="form-select">
                                <option value="Real Estate">Real Estate</option>
                                <option value="Vehicle">Vehicle</option>
                                <option value="Equipment">Equipment</option>
                            </select>
                            <span asp-validation-for="AssetType" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ClientId" class="form-label fw-bold">Assigned Owner (Client)</label>
                            <select asp-for="ClientId" class="form-select" asp-items="ViewBag.ClientId">
                                <option value="">-- Unassigned --</option>
                            </select>
                            <span asp-validation-for="ClientId" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-warning fw-bold">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>