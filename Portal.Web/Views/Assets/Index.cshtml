@model IEnumerable<Portal.Data.Assets>

@{
    ViewData["Title"] = "Manage Assets";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Registered Assets</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Register New Asset
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Asset Name / Unit</th>
                        <th>Type</th>
                        <th>Owner (Client)</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var asset in Model)
                    {
                        <tr>
                            <td>@asset.AssetId</td>
                            <td class="fw-bold">@asset.AssetName</td>
                            <td>
                                <span class="badge bg-secondary">@asset.AssetType</span>
                            </td>
                            <td>
                                @if (asset.Client != null)
                                {
                                    <span>@asset.Client.FullName</span>
                                }
                                else
                                {
                                    <span class="text-danger">Unassigned</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-success">Active</span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No assets found. Click "Register New Asset" to create one.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>