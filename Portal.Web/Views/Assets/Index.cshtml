@model IEnumerable<Portal.Data.Assets>

@{
    ViewData["Title"] = "Manage Assets";
}

<div class="container mt-5 pb-5">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <strong>Action Blocked:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-secondary">
            <i class="bi bi-laptop me-2"></i>Registered Assets
        </h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Register New Asset
        </a>
    </div>

    <div class="card shadow border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">ID</th>
                            <th>Asset Name / Unit</th>
                            <th>Type</th>
                            <th>Owner (Client)</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var asset in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">#@asset.AssetId</td>
                                <td class="fw-semibold">@asset.AssetName</td>
                                <td>
                                    <span class="badge bg-secondary text-light border border-secondary">
                                        @asset.AssetType
                                    </span>
                                </td>
                                <td>
                                    @if (asset.Client != null)
                                    {
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-person-fill text-muted me-2"></i>
                                            @asset.Client.FullName
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-danger small fw-bold">Unassigned</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-success bg-opacity-75">Active</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Edit" asp-route-id="@asset.AssetId" class="btn btn-sm btn-outline-warning text-dark" title="Edit Asset">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-action="Delete" asp-route-id="@asset.AssetId" method="post"
                                              onsubmit="return confirm('Are you sure you want to delete @asset.AssetName?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Asset">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No assets found. Click "Register New Asset" to create one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>