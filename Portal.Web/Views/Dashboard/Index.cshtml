@model IEnumerable<Portal.Data.ViewModels.TicketViewModel>

<h2>My Tickets</h2>

<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Title</th>
            <th>Asset</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.CreatedAt.ToShortDateString()</td>
                <td>@ticket.Title</td>
                <td>@ticket.AssetName</td>
                <td>
                    <span class="badge @(ticket.StatusName == "Open" ? "bg-success" : "bg-secondary")">
                        @ticket.StatusName
                    </span>
                </td>
                <td>
                    <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.TicketId">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>