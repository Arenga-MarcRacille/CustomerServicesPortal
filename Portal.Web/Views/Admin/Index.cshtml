@model IEnumerable<Portal.Data.Tickets>
@using System.Collections.Concurrent

@{
    ViewData["Title"] = "Admin Console";
    var stats = ViewBag.Stats as ConcurrentDictionary<string, int>;
}

<div class="container-fluid mt-4 pb-5">
    <div class="row g-3 mb-4 align-items-center">
        <div class="col-12 col-md-6">
            <h2 class="text-danger fw-bold mb-0">
                <i class="bi bi-speedometer2 me-2"></i>Support Console
            </h2>
        </div>
        <div class="col-12 col-md-6 text-md-end">
            <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                <span class="badge bg-primary px-3 py-2">Total: @stats["Total"]</span>
                <span class="badge bg-danger px-3 py-2">Active: @stats["Open"]</span>
                <span class="badge bg-success px-3 py-2">Closed: @stats["Closed"]</span>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0 small text-uppercase tracking-wider">Ticket Management</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">ID</th>
                            <th>Client</th>
                            <th class="d-none d-lg-table-cell">Asset</th>
                            <th>Issue</th>
                            <th class="text-center">Status</th>
                            <th class="d-none d-md-table-cell">Files</th>
                            <th class="pe-3 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">#@ticket.TicketId</td>
                                <td>
                                    <div class="fw-semibold text-truncate" style="max-width: 120px;">@ticket.Client.FullName</div>
                                    <small class="text-muted d-none d-md-block">@ticket.Client.Email</small>
                                </td>
                                <td class="d-none d-lg-table-cell">
                                    <span class="badge border text-dark bg-white fw-normal">@ticket.Asset.AssetName</span>
                                </td>
                                <td>
                                    <span class="d-inline-block text-truncate" style="max-width: 150px;" title="@ticket.Title">
                                        @ticket.Title
                                    </span>
                                </td>
                                <td class="text-center">
                                    @{
                                        var statusColor = ticket.TicketStatus.StatusName switch
                                        {
                                            "Open" => "bg-danger",
                                            "InProgress" => "bg-warning text-dark",
                                            "Resolved" => "bg-success",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @statusColor rounded-pill px-2 py-1" style="font-size: 0.75rem;">
                                        @ticket.TicketStatus.StatusName
                                    </span>
                                </td>
                                <td class="d-none d-md-table-cell">
                                    @if (ticket.DocumentRequests?.Any() == true)
                                    {
                                        <a href="@ticket.DocumentRequests.First().FilePath" class="btn btn-sm btn-link p-0 text-info">
                                            <i class="bi bi-file-earmark-arrow-down fs-5"></i>
                                        </a>
                                    }
                                    else
                                    {

                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="pe-3 text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.TicketId"
                                           class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-dark"
                                                data-bs-toggle="modal"
                                                data-bs-target="#updateStatusModal"
                                                data-ticket-id="@ticket.TicketId"
                                                data-current-status="@ticket.TicketStatus.StatusId">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="updateStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="bi bi-speedometer2 me-2"></i>Update Ticket Status</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="UpdateStatus" method="post">
                <div class="modal-body">
                    <input type="hidden" name="ticketId" id="modalTicketId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Select New Status:</label>
                        <select name="statusId" id="modalStatusSelect" class="form-select form-select-lg">
                            <option value="5">Open</option>
                            <option value="6">InProgress</option>
                            <option value="7">Resolved</option>
                            <option value="8">Closed</option>
                        </select>
                    </div>

                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        Updating this status will automatically log an entry in the <strong>Ticket Timeline</strong>.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // When the modal is about to open
        var updateModal = document.getElementById('updateStatusModal');
        updateModal.addEventListener('show.bs.modal', function (event) {
            // Button that triggered the modal
            var button = event.relatedTarget;

            // Extract info from data-* attributes
            var ticketId = button.getAttribute('data-ticket-id');
            var statusId = button.getAttribute('data-current-status');

            // Update the modal's content
            var modalInput = updateModal.querySelector('#modalTicketId');
            var modalSelect = updateModal.querySelector('#modalStatusSelect');

            modalInput.value = ticketId;
            modalSelect.value = statusId;
        });
    </script>
}