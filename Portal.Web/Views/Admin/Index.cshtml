@model IEnumerable<Portal.Data.Tickets>
@using System.Collections.Concurrent

@{
    ViewData["Title"] = "Admin Console";
    var stats = ViewBag.Stats as ConcurrentDictionary<string, int>;
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2 class="text-danger"><i class="bi bi-speedometer2"></i> Support Console</h2>
        </div>
        <div class="col-md-6 text-end">
            <span class="badge bg-primary p-2">Total Tickets: @stats["Total"]</span>
            <span class="badge bg-danger p-2">Active: @stats["Open"]</span>
            <span class="badge bg-success p-2">Closed: @stats["Closed"]</span>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between">
            <h5 class="mb-0">Ticket Management</h5>
            <small>Live Data</small>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-secondary">
                    <tr>
                        <th>ID</th>
                        <th>Client / Owner</th>
                        <th>Asset Unit</th>
                        <th>Issue</th>
                        <th>Status</th>
                        <th>Attachment</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model)
                    {
                        <tr>
                            <td><strong>#@ticket.TicketId</strong></td>
                            <td>
                                <div>@ticket.Client.FullName</div>
                                <small class="text-muted">@ticket.Client.Email</small>
                            </td>
                            <td>@ticket.Asset.AssetName</td>
                            <td>
                                <span class="d-inline-block text-truncate" style="max-width: 200px;" title="@ticket.Title">
                                    @ticket.Title
                                </span>
                            </td>
                            <td>
                                @if (ticket.TicketStatus.StatusName == "Open")
                                {
                                    <span class="badge bg-danger">Open</span>
                                }
                                else if (ticket.TicketStatus.StatusName == "InProgress")
                                {

                                    <span class="badge bg-warning text-dark">In Progress</span>
                                }
                                else
                                {

                                    <span class="badge bg-success">Closed</span>
                                }
                            </td>
                            <td>
                                @if (ticket.DocumentRequests != null && ticket.DocumentRequests.Any())
                                {
                                    foreach (var doc in ticket.DocumentRequests)
                                    {
                                        <a href="@doc.FilePath" download target="_blank" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-download"></i> Download
                                        </a>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">No Files</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.TicketId"
                                       class="btn btn-sm btn-outline-primary" title="View Details">
                                        <i class="bi bi-eye-fill"></i>
                                        View Details
                                    </a>

                                    <form asp-action="UpdateStatus" method="post" class="d-flex align-items-center gap-2">
                                        <input type="hidden" name="ticketId" value="@ticket.TicketId" />

                                        <select name="statusId" class="form-select form-select-sm" style="width: 120px;">
                                            <option value="5" selected="@(ticket.TicketStatus.StatusName == "Open")">Open</option>
                                            <option value="6" selected="@(ticket.TicketStatus.StatusName == "InProgress")">In Progress</option>
                                            <option value="7" selected="@(ticket.TicketStatus.StatusName == "Resolved")">Resolved</option>
                                            <option value="8" selected="@(ticket.TicketStatus.StatusName == "Closed")">Closed</option>
                                        </select>

                                        <button type="submit" class="btn btn-sm btn-dark">Update</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>